<?xml version="1.0" encoding="utf-8"?>
<!--
  USB device filter for Android's ACTION_USB_DEVICE_ATTACHED hand-off.
  When one of these printers is plugged in, Android offers to open Gundam POS.

  Covers the four bridge chips built into the APK (see UsbSerialDrivers.kt):
    CH340/CH341  vendor 0x1A86 (6790)
    PL2303       vendor 0x067B (1659)
    FTDI         vendor 0x0403 (1027)
  plus the common CDC-ACM serial vendors (matched by interface class at runtime).

  Numbers are DECIMAL (the <usb-device> attributes are decimal, not hex).
-->
<resources>
    <!-- CH340 / CH341 / CH9102 (WCH) -->
    <usb-device vendor-id="6790" product-id="29987" /> <!-- 1A86:7523 CH340  -->
    <usb-device vendor-id="6790" product-id="21795" /> <!-- 1A86:5523 CH341A -->
    <usb-device vendor-id="6790" product-id="29986" /> <!-- 1A86:7522 CH341  -->
    <usb-device vendor-id="6790" product-id="21972" /> <!-- 1A86:55D4 CH9102 -->

    <!-- Prolific PL2303 (HX / HXA) -->
    <usb-device vendor-id="1659" product-id="8963" /> <!-- 067B:2303 -->
    <usb-device vendor-id="1659" product-id="8964" /> <!-- 067B:2304 -->

    <!-- FTDI FT232R / FT231X / FT232H family -->
    <usb-device vendor-id="1027" product-id="24577" /> <!-- 0403:6001 FT232R  -->
    <usb-device vendor-id="1027" product-id="24597" /> <!-- 0403:6015 FT231X  -->
    <usb-device vendor-id="1027" product-id="24596" /> <!-- 0403:6014 FT232H  -->
    <usb-device vendor-id="1027" product-id="24592" /> <!-- 0403:6010 FT2232H -->
    <usb-device vendor-id="1027" product-id="24593" /> <!-- 0403:6011 FT4232H -->

    <!-- Generic CDC-ACM serial vendors (matched by class 0x02/0x0A at runtime) -->
    <usb-device vendor-id="9025" />  <!-- 0x2341 Arduino SA        -->
    <usb-device vendor-id="10755" /> <!-- 0x2A03 Arduino LLC       -->
    <usb-device vendor-id="1155" />  <!-- 0x0483 STMicroelectronics-->
    <usb-device vendor-id="12346" /> <!-- 0x303A Espressif         -->
    <usb-device vendor-id="7855" />  <!-- 0x1EAF LeafLabs          -->
    <usb-device vendor-id="9114" />  <!-- 0x239A Adafruit          -->
    <usb-device vendor-id="6421" />  <!-- 0x1915 Nordic            -->
    <usb-device vendor-id="4617" />  <!-- 0x1209 pid.codes         -->
</resources>
